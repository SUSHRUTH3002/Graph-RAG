# Database Configuration
# Note: Use port 7687 for Bolt protocol (application access)
#       Port 7474 is for HTTP/Browser interface only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Embedding Configuration
EMBEDDING_BACKEND=hf
OPENAI_API_KEY=
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Chunking Configuration
CHUNKING_METHOD=fixed
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# CSV Chunking Configuration
CSV_ROW_FORMAT=key_value
CSV_INCLUDE_HEADER=true

# Entity Extraction Configuration
ENTITY_EXTRACTION_METHOD=csv
ENTITY_LLM_MODEL=gpt-3.5-turbo

# Relationship Extraction Configuration
RELATIONSHIP_EXTRACTION_METHOD=csv
